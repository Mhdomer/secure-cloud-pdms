# ── Local development only ──────────────────────────────────────────────────
# Never commit .env — production values come from SSM Parameter Store

NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=8h

# Database (local dev — production uses SSM)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdms
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_SSL=false

# AWS (only needed in prod — local uses DB_* vars above)
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
SSM_DB_PREFIX=/pdms/prod/db
