# ── Local development only ──────────────────────────────────────────────────
# Never commit .env — production values come from SSM Parameter Store

NODE_ENV=development
PORT=5000

# JWT
# 15 minutes per Chapter 4 §4.3.8.1 / HIPAA §164.312(a)(2)(iii) automatic
# logoff. No refresh-token flow in Sprint 3a — user re-authenticates after
# expiry.
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=15m

# Database — the running app (`npm run dev` / `npm start`) MUST connect as
# the least-privilege `pdms_app` role, never the postgres superuser/master
# user, or every RLS policy in src/config/schema.sql is silently bypassed
# and never actually tested. `pdms_app` is created automatically the first
# time schema.sql is run (as postgres):
#   psql -U postgres -d pdms -f src/config/schema.sql
# Production uses the equivalent role provisioned via Terraform/SSM instead
# of these values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdms
DB_USER=pdms_app
DB_PASSWORD=change_me_local_dev_only
DB_SSL=false

# CORS — only this origin (the CloudFront distribution) may call the API
CLOUDFRONT_ORIGIN=http://localhost:3000

# Cookie security — kept as its own flag rather than inferred from NODE_ENV
# so a staging/pre-prod stack behind real TLS never accidentally ships
# `secure: false` cookies just because NODE_ENV isn't the literal string
# "production". Only set to false for local HTTP-only development.
COOKIE_SECURE=false

# AWS (only needed in prod — local uses DB_* vars above)
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
SSM_DB_PREFIX=/pdms/prod/db

# Logging
LOG_LEVEL=info

# Admin bootstrap (scripts/seed-admin.js only — not read by the server):
#   ADMIN_USERNAME=admin ADMIN_PASSWORD=<12+ char secret> npm run seed:admin
# There is no seeded admin account in schema.sql or anywhere in git.
