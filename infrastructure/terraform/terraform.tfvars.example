# Copy this file to terraform.tfvars (git-ignored) and fill in real values.
# NEVER commit terraform.tfvars — it is excluded by .gitignore.
# In CI/CD, these are supplied as GitHub Actions secrets / OIDC-derived
# values instead of a committed tfvars file (see Sprint 4).

project_name = "pdms"
environment  = "prod"
aws_region   = "ap-southeast-1"

# IAM principal ARNs allowed to administer the KMS CMK (Terraform deployer
# role / named break-glass admins). Example placeholder — replace with real ARNs.
kms_key_administrator_arns = [
  "arn:aws:iam::123456789012:role/pdms-terraform-deploy-role"
]

db_name             = "pdms"
db_username         = "pdms_admin"
db_instance_class   = "db.t3.micro"
db_multi_az         = true
db_deletion_protection = true

# ACM certificate must already be issued/validated for the clinic's domain
# before `terraform apply` — Terraform does not create it in this sprint.
acm_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/REPLACE-ME"

# Pin to a specific, patched Amazon Linux 2023 AMI ID — never resolve "latest".
ec2_ami_id = "ami-REPLACE-ME"

ec2_instance_type    = "t3.small"
ec2_min_size          = 2
ec2_max_size          = 4
ec2_desired_capacity = 2

log_retention_days = 90
