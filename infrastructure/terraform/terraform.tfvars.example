# Copy this file to terraform.tfvars (git-ignored) and fill in real values.
# NEVER commit terraform.tfvars — it is excluded by .gitignore.
# In CI/CD, these are supplied as GitHub Actions secrets / OIDC-derived
# values instead of a committed tfvars file (see Sprint 4).

project_name = "pdms"
environment  = "prod"
aws_region   = "ap-southeast-1"

# IAM principal ARNs allowed to administer the KMS CMK (named human
# break-glass admins). Example placeholder — replace with real ARNs.
# NOTE: the CI/CD deploy role (modules/github-oidc, Sprint 4) does NOT need
# to be listed here — it already gets kms:* on this key via its own IAM
# identity policy, which the key's "EnableRootAccountFullAccess" statement
# (modules/kms/main.tf) turns into usable access without a separate
# key-policy entry per principal.
kms_key_administrator_arns = [
  "arn:aws:iam::123456789012:role/pdms-break-glass-admin"
]

# GitHub repository allowed to assume the CI/CD deploy role (Sprint 4,
# modules/github-oidc) — sole scope of the OIDC trust condition.
github_repository       = "Mhdomer/secure-cloud-pdms"
github_oidc_environment = "production"

db_name             = "pdms"
db_username         = "pdms_admin"
db_instance_class   = "db.t3.micro"
db_multi_az         = true
db_deletion_protection = true

# ACM certificate must already be issued/validated for the clinic's domain
# before `terraform apply` — Terraform does not create it in this sprint.
acm_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/REPLACE-ME"

# Pin to a specific, patched Amazon Linux 2023 AMI ID — never resolve "latest".
ec2_ami_id = "ami-REPLACE-ME"

ec2_instance_type    = "t3.small"
ec2_min_size          = 2
ec2_max_size          = 4
ec2_desired_capacity = 2

log_retention_days = 90
